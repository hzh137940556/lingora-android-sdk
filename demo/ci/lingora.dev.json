{
  "apiUrl": "https://lingora-dev.fun.brain.ai",
  "projectId": "6acbf9e2-b605-40e4-90b1-066fbb1d4506",
  "branch": "develop",
  "format": "ANDROID_XML",
  "push": {
    "files": [
      {
        "path": "../app/src/main/res/values/strings.xml",
        "language": "en-US",
        "namespace": "app"
      },
      {
        "path": "../app/src/main/res/values/arrays.xml",
        "language": "en-US",
        "namespace": "app"
      }
    ],
    "forceMode": "OVERRIDE",
    "overrideMode": "RECOMMENDED",
    "errorOnUnresolvedConflict": "auto",
    "overrideKeyDescriptions": false,
    "convertPlaceholdersToIcu": false,
    "tagNewKeys": [],
    "removeOtherKeys": false
  },
  "pull": {
    "path": "../generated/lingora/res",
    "languages": ["ja", "zh-CN"],
    "namespaces": ["app"],
    "states": ["TRANSLATED", "REVIEWED"],
    "fileStructureTemplate": "values-{androidLanguageTag}/strings.{extension}",
    "emptyDir": true
  },
  "contentDeliveries": {
    "current": "https://cosly-dev.s3.us-west-2.amazonaws.com/lingora/localstrings/dev/v1"
  }
}
